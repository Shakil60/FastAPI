# Copier ce fichier en .env puis adapter les valeurs (ne jamais committer .env)

# Base locale lancée par docker compose (sur Scalingo, SCALINGO_POSTGRESQL_URL est fourni par l'addon)
DATABASE_URL=postgresql://recipe:recipe@localhost:5432/recipe

# Clé de signature des JWT : générer une valeur avec  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origines autorisées pour CORS, séparées par des virgules (URL du client)
CORS_ORIGINS=http://localhost:5173
